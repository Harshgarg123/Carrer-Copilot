{
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@tesseract.js-data/eng/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}